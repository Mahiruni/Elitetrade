[Unit]
Description=EliteBridge private DEMO broker data gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=elitebridge
Group=elitebridge
WorkingDirectory=/opt/elitetrade
EnvironmentFile=/etc/elitebridge/gateway.env
StateDirectory=elitebridge
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/flock --nonblock /var/lib/elitebridge/gateway.lock /usr/bin/xvfb-run --auto-servernum "--server-args=-screen 0 1280x800x24 -nolisten tcp" /usr/bin/node /opt/elitetrade/scripts/elitebridge-cloud-gateway.mjs serve
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
# Xvfb, its private Xauthority and Wine share this service's isolated /tmp.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/elitebridge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
