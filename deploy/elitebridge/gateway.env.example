# Operator configuration only. No passwords or service tokens belong here.
ELITEBRIDGE_GATEWAY_KEY_FILE=/var/lib/elitebridge/private/gateway.key
ELITEBRIDGE_GATEWAY_VAULT_FILE=/var/lib/elitebridge/private/gateway.vault
ELITEBRIDGE_GATEWAY_PORT=8787
ELITEBRIDGE_GATEWAY_EXECUTABLE=/usr/bin/wine
# Both Windows Python and MT5 must use the SAME isolated Wine prefix.
# Z: is Wine's default mapping to the Linux filesystem. Review on target host.
ELITEBRIDGE_GATEWAY_ARGS='["C:\\Python312\\python.exe","Z:\\opt\\elitetrade\\companion\\mt5_cloud_gateway.py"]'
WINEPREFIX=/var/lib/elitebridge/wine
WINEDEBUG=-all
HOME=/var/lib/elitebridge
# Configure an actual private display/session; this file does not start Xvfb.
DISPLAY=:99
