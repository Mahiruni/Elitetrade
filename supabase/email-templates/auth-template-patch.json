{
  "mailer_subjects_confirmation": "Confirm your email for EliteTrade",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Confirm your email for EliteTrade</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">One confirmation to finish creating your EliteTrade account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">CONFIRM YOUR EMAIL</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">One step to your account.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">You requested an EliteTrade account using {{ .Email }}. Confirm your email address to finish registration.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">Open the link in your browser. Once confirmed, sign in to EliteTrade on the website or return to the Android app.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Confirm email address</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#946b2d\">{{ .ConfirmationURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not request this account, ignore this email. Only confirm a registration you started.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_magic_link": "Your secure EliteTrade sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Your secure EliteTrade sign-in link</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">Use your secure link or verification code to continue.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">ACCOUNT ACCESS</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">Your sign-in link is ready.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">A sign-in link was requested for your EliteTrade account. Use the button below to continue.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">If your screen asks for a verification code, enter the code below on that screen.</p>\n<p class=\"email-note\" style=\"font-size:12px;color:#617087;margin:22px 0 8px\">YOUR VERIFICATION CODE</p><p class=\"email-code\" style=\"background:#f1f3f7;color:#142033;border-radius:10px;padding:18px;text-align:center;font-size:28px;letter-spacing:5px;font-family:Consolas,monospace\">{{ .Token }}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Continue to EliteTrade</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#946b2d\">{{ .ConfirmationURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not request this message, ignore it. Never share this link or code.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_recovery": "Reset your EliteTrade password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Reset your EliteTrade password</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">Choose a new password using your secure recovery link.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">ACCOUNT RECOVERY</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">Choose a new password.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">A password reset was requested for your EliteTrade account. Use the button below to choose a new password.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">Open the link in your browser. After saving your password, sign in again on the website or in the Android app.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Reset password</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#946b2d\">{{ .ConfirmationURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not request this reset, ignore this email. Your password remains unchanged unless you complete the reset.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_email_change": "Confirm your new EliteTrade email address",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Confirm your new EliteTrade email address</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">Confirm the request to update your sign-in email address.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">ACCOUNT DETAILS</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">Confirm your email change.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">You requested to change the sign-in email for your EliteTrade account to {{ .NewEmail }}.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">Confirm only if you requested this change. Depending on your security settings, approval from both addresses may be required.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Confirm email change</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#946b2d\">{{ .ConfirmationURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not request this change, do not confirm it. Open EliteTrade directly and contact support.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_invite": "You’re invited to EliteTrade",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>You’re invited to EliteTrade</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">Accept your invitation and set up your EliteTrade account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">ACCOUNT INVITATION</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">You’re invited to EliteTrade.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">You have been invited to create an EliteTrade account. Accept the invitation to continue setting up your account.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Accept invitation</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#946b2d\">{{ .ConfirmationURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you were not expecting this invitation, you can ignore this email.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Your EliteTrade password was changed",
  "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Your EliteTrade password was changed</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">A password change was completed. Review it if this was not you.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">SECURITY NOTICE</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">Your password was changed.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">The password for your EliteTrade account was changed.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">If you made this change, no further action is needed.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .SiteURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Review your account</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .SiteURL }}\" style=\"color:#946b2d\">{{ .SiteURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not make this change, open EliteTrade directly, reset your password, and contact support.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_email_changed_notification": "Your EliteTrade email address was changed",
  "mailer_templates_email_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Your EliteTrade email address was changed</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">Your sign-in email was updated. Review it if this was not you.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">SECURITY NOTICE</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">Your email address changed.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">Your EliteTrade sign-in email was changed from {{ .OldEmail }} to {{ .Email }}.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">If you requested and confirmed this change, no further action is needed.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .SiteURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Review your account</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .SiteURL }}\" style=\"color:#946b2d\">{{ .SiteURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not make this change, open EliteTrade directly and contact support immediately.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
  "mailer_subjects_reauthentication": "Your EliteTrade verification code",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"supported-color-schemes\" content=\"light dark\"><title>Your EliteTrade verification code</title>\n<style>:root{color-scheme:light dark;supported-color-schemes:light dark}a{word-break:break-word}@media(prefers-color-scheme:dark){.email-bg{background:#090b10!important}.email-card{background:#151921!important;border-color:#343a45!important}.email-title{color:#f4f6fa!important}.email-copy{color:#d0d6df!important}.email-note{color:#adb7c7!important}.email-rule{border-color:#343a45!important}.email-code{background:#222936!important;color:#f4f6fa!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all\">Enter this one-time code to confirm the action you requested.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:28px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-card\" style=\"max-width:600px;table-layout:fixed;background:#ffffff;border:1px solid #e0e4eb;border-radius:18px\">\n<tr><td bgcolor=\"#090b10\" style=\"background:#090b10;padding:24px 28px;border-radius:18px 18px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"64\"><img src=\"https://elitetradee.vercel.app/logo.jpg\" alt=\"EliteBot\" width=\"56\" height=\"56\" style=\"display:block;border:0;border-radius:8px;color:#ffffff;font-size:12px\"></td><td style=\"padding-left:12px;color:#ffffff;font-size:22px;font-weight:700;letter-spacing:-.5px\">Elite<span style=\"color:#e8ba67\">Trade</span><br><span style=\"font-size:11px;font-weight:400;letter-spacing:1px;color:#b8c1cf\">ACCOUNT SERVICES</span></td></tr></table></td></tr>\n<tr><td style=\"padding:32px 28px 28px\"><p style=\"margin:0 0 12px;font-size:11px;line-height:18px;letter-spacing:1.5px;font-weight:700;color:#946b2d\">VERIFY YOUR IDENTITY</p>\n<h1 class=\"email-title\" style=\"margin:0 0 20px;color:#142033;font-size:28px;line-height:36px;letter-spacing:-.7px;font-weight:650\">Confirm it’s you.</h1>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">Use this one-time code on the screen where you requested verification.</p>\n<p class=\"email-copy\" style=\"margin:0 0 18px;color:#48546a;font-size:16px;line-height:26px\">The button below returns to EliteTrade. It does not approve the action or verify this code.</p>\n<p class=\"email-note\" style=\"font-size:12px;color:#617087;margin:22px 0 8px\">YOUR VERIFICATION CODE</p><p class=\"email-code\" style=\"background:#f1f3f7;color:#142033;border-radius:10px;padding:18px;text-align:center;font-size:28px;letter-spacing:5px;font-family:Consolas,monospace\">{{ .Token }}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0 16px\"><tr><td align=\"center\" bgcolor=\"#e8ba67\" style=\"border-radius:10px;mso-padding-alt:16px 20px\"><a href=\"{{ .SiteURL }}\" style=\"display:block;padding:16px 20px;border:1px solid #e8ba67;border-radius:10px;background:#e8ba67;color:#131b28;font-size:16px;line-height:22px;font-weight:700;text-decoration:none\">Return to EliteTrade</a></td></tr></table>\n<p class=\"email-note\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#617087\">If the button does not open, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere\"><a href=\"{{ .SiteURL }}\" style=\"color:#946b2d\">{{ .SiteURL }}</a></p>\n<p class=\"email-note email-rule\" style=\"border-top:1px solid #e4e7ed;padding-top:20px;margin:0;color:#617087;font-size:13px;line-height:22px\">If you did not request this code, ignore this email. Never share verification codes with anyone.</p></td></tr>\n<tr><td class=\"email-rule\" style=\"border-top:1px solid #e4e7ed;padding:20px 28px\"><p class=\"email-note\" style=\"margin:0;color:#617087;font-size:12px;line-height:20px\">EliteTrade · Account services<br>Need help? <a href=\"https://elitetradee.vercel.app/support\" style=\"color:#946b2d\">Contact support</a><br>This is an account message, not a trading signal.</p></td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>"
}
