{
  "name": "elitetrade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "worker:demo": "node --env-file-if-exists=.env scripts/demo-worker.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": { "nodemailer": "10.0.13", "qrcode": "1.5.4" }
}
