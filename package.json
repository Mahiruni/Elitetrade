{
  "name": "elitetrade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "worker:demo": "node --env-file-if-exists=.env scripts/demo-worker.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "build": "node scripts/build-claude-pro.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/claude-pro/tsconfig.json",
    "bridge:real:sandbox": "node scripts/elitebridge-real-observation-sandbox.mjs"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "nodemailer": "10.0.13",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
