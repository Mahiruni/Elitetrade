NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SQLITE_PATH=./data/elitetrade.sqlite
# Required in production: a random 32-byte key, encoded as base64.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Both are required for the live MT5 gateway adapter. No sample trading is used.
MT5_GATEWAY_URL=
MT5_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
# Docker Compose / Caddy production domain (without https://).
APP_DOMAIN=
