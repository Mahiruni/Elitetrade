NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Local/legacy SQLite development only. Vercel production persists data in Supabase.
SQLITE_PATH=./data/elitetrade.sqlite
# Local ebook delivery only: absolute path to the full PDF outside public/ and this repository.
EBOOK_PDF_PATH=
# Used only by the local/legacy SQLite backend. Production MT5 secrets use Supabase Vault.
ENCRYPTION_KEY=
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Both are required for the live MT5 gateway adapter. No sample trading is used.
MT5_GATEWAY_URL=
MT5_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
# Docker Compose / Caddy production domain (without https://).
APP_DOMAIN=

# Supabase Auth / persistent identity for EliteTrade
SUPABASE_URL=https://cgpvhayfwnpipktyltho.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SNPQ5m9R3hv3Y7Uw-icxEQ_WSng7M8W


# Optional hosted connection: per-user MT5 demo and real account data.
# Keep these server-side. MetaApi subscriptions/usage are billed by the provider.
MT5_GATEWAY_PROVIDER=
METAAPI_TOKEN=
METAAPI_REGION=new-york

# Persistent demo worker only: never expose this key to the browser.
# Configure these on an always-on Node worker, not as public frontend settings.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_EXECUTION_ENABLED=false
