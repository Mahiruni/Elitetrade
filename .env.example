NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Local/legacy SQLite development only. Vercel production persists data in Supabase.
SQLITE_PATH=./data/elitetrade.sqlite
# Used only by the local/legacy SQLite backend. Production MT5 secrets use Supabase Vault.
ENCRYPTION_KEY=
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Both are required for the live MT5 gateway adapter. No sample trading is used.
MT5_GATEWAY_URL=
MT5_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
# Docker Compose / Caddy production domain (without https://).
APP_DOMAIN=

# Supabase Auth / persistent identity for EliteTrade
SUPABASE_URL=https://amwpbnczylbarqqcprev.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Supabase CAPTCHA frontend configuration.
# Must match Authentication > Bot and Abuse Protection in Supabase.
# Supported values: turnstile | hcaptcha
CAPTCHA_PROVIDER=turnstile
# Public site key from your CAPTCHA provider (safe to expose in the browser).
CAPTCHA_SITE_KEY=
